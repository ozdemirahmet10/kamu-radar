# Application
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://kpss:kpss@localhost:5432/kpss_kariyer_asistani?schema=public

# Redis (cache + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP/SendGrid/SES adapter ortak alanlar)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@kpss-kariyer.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Web Push (VAPID)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@kpss-kariyer.com

# Object Storage (ham crawl verisi)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raw-job-postings
S3_REGION=us-east-1

# LLM Parsing
ANTHROPIC_API_KEY=

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=20
